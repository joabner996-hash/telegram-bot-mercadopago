PORT=3000
NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=cole_o_token_novo_do_bot_aqui
TELEGRAM_WEBHOOK_SECRET=troque_por_um_texto_grande_e_aleatorio

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=cole_o_access_token_aqui
MERCADOPAGO_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_webhook_aqui
MP_USE_SANDBOX=true

# URL publica do app, sem barra final. Exemplo:
# https://manual-cozinha.up.railway.app
PUBLIC_BASE_URL=

# Produto
PRODUCT_NAME=Manual de Sobrevivência: Edição Cozinha
PRODUCT_PRICE=8.99
PRODUCT_CURRENCY=BRL
EBOOK_PATH=output/manual_sobrevivencia_edicao_cozinha.pdf

# Opcional: link de suporte exibido para o cliente
SUPPORT_URL=https://t.me/MSCoz_bot
